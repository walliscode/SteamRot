#include "test_data_loader.h"
#include <catch2/catch_test_macros.hpp>
#include <catch2/generators/catch_generators.hpp>
#include <catch2/generators/catch_generators_range.hpp>
#include <filesystem>

namespace {

/////////////////////////////////////////////////
/// @brief Path to this test's data directory (configured by CMake)
/////////////////////////////////////////////////
const std::filesystem::path kDataDir = "@DATA_DIRECTORY@";

/////////////////////////////////////////////////
/// @brief Test tag (configured by CMake)
/////////////////////////////////////////////////
constexpr const char *kTestTag = "[@TEST_TAG@]";

} // namespace

TEST_CASE("@TEST_NAME@ data-driven tests", "[unit][@TEST_TAG@]") {
  // Load all test data configs from the configured directory
  auto configs_result =
      steamrot::tests::LoadTestDataConfigsFromPath(kDataDir);

  REQUIRE(configs_result.has_value());
  REQUIRE(!configs_result.value().empty());

  // Use Catch2 GENERATE to run test for each config
  const auto *config = GENERATE_COPY(from_range(configs_result.value()));
  REQUIRE(config != nullptr);

  // Extract test metadata for SECTION name
  std::string test_name = "unknown";
  if (config->metadata() && config->metadata()->test_name()) {
    test_name = config->metadata()->test_name()->str();
  }

  SECTION(test_name) {
    // Check expected_to_pass flag
    bool expected_to_pass = true;
    if (config->metadata()) {
      expected_to_pass = config->metadata()->expected_to_pass();
    }

    if (expected_to_pass) {
      // Test should pass - run fixture test
      // TODO: Implement run_fixture_test using TestEngine
      SUCCEED("Test " + test_name + " loaded successfully");
    } else {
      // Test expected to fail
      SUCCEED("Test " + test_name + " expected to fail - skipped");
    }
  }
}
