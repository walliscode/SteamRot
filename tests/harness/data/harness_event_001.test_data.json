{
  "metadata": {
    "test_name": "sample_event_sequence",
    "given": "An empty entity pool with no initial events",
    "when": "Events are injected tick-by-tick over 3 ticks",
    "then": "Events are properly added to event bus at each tick",
    "tags": [
      "unit",
      "harness",
      "event"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "event_sequence": {
    "events": [
      {
        "tick": 1,
        "event_packet": {
          "event_lifetime": 5,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        }
      },
      {
        "tick": 2,
        "event_packet": {
          "event_lifetime": 3,
          "event_type": "EVENT_USER_INPUT",
          "event_data_data_type": "UserInputBitsetData",
          "event_data_data": {
            "keyboard_pressed": [
              "A",
              "W"
            ],
            "mouse_pressed": [
              "LEFT_CLICK"
            ]
          }
        }
      },
      {
        "tick": 3,
        "event_packet": {
          "event_lifetime": 1,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        }
      }
    ]
  },
  "start_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 1,
      "entities": []
    }
  }
}