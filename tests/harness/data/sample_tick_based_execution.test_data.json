{
  "metadata": {
    "test_name": "sample_tick_based_execution",
    "description": "Demonstrates tick-based test execution with coordinated inputs, events, and simulation",
    "tags": ["unit", "harness", "tick", "simulation"],
    "expected_to_pass": true,
    "version": 1
  },
  "num_ticks": 5,
  "input_sequence": {
    "description": "Mouse movement over 5 ticks",
    "inputs": [
      {
        "input_type": "MouseMove",
        "input_data_type": "MouseInputData",
        "input_data": {
          "position": { "x": 100.0, "y": 100.0 },
          "button": 0
        },
        "tick": 0,
        "description": "Start position"
      },
      {
        "input_type": "MouseMove",
        "input_data_type": "MouseInputData",
        "input_data": {
          "position": { "x": 125.0, "y": 115.0 },
          "button": 0
        },
        "tick": 2,
        "description": "Mid-way position"
      },
      {
        "input_type": "MouseMove",
        "input_data_type": "MouseInputData",
        "input_data": {
          "position": { "x": 150.0, "y": 125.0 },
          "button": 0
        },
        "tick": 4,
        "description": "Final position"
      }
    ]
  },
  "event_sequence": {
    "description": "Events triggered at specific ticks",
    "events": [
      {
        "tick": 0,
        "event_packet": {
          "event_lifetime": 5,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        },
        "description": "Start event at tick 0"
      },
      {
        "tick": 2,
        "event_packet": {
          "event_lifetime": 3,
          "event_type": "EVENT_USER_INPUT",
          "event_data_data_type": "NONE"
        },
        "description": "Mid event at tick 2"
      },
      {
        "tick": 4,
        "event_packet": {
          "event_lifetime": 1,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        },
        "description": "End event at tick 4"
      }
    ]
  },
  "simulation_data": {
    "description": "Simulation steps executed on every tick",
    "num_ticks": 5,
    "steps": [
      {
        "simulation_type": "Collision",
        "execution_mode": "LogicClass",
        "logic_class_type": "UICollisionLogic",
        "description": "Collision check (runs every tick)"
      },
      {
        "simulation_type": "Action",
        "execution_mode": "Function",
        "function_type": "ProcessButtonElementActions",
        "description": "Process actions (runs every tick)"
      }
    ]
  },
  "start_entity_collection": {
    "entity_memory_pool_size": 2,
    "entities": [
      {
        "index": 0,
        "c_user_interface": {
          "ui_name": "button_ui",
          "start_visible": true,
          "root_ui_element": {
            "base_data": {
              "position": { "x": 100, "y": 100 },
              "size": { "x": 100, "y": 50 },
              "children_active": false,
              "children": [],
              "layout": "Horizontal",
              "spacing_strategy": "None"
            }
          }
        }
      }
    ]
  }
}
