{
  "metadata": {
    "test_name": "event_bus_snapshot_test",
    "given": "An event bus with 2 events (EVENT_TEST lifetime 3, EVENT_QUIT_GAME lifetime 5)",
    "when": "Two ticks pass with snapshot comparisons at each tick",
    "then": "Event lifetimes decrement correctly at each snapshot",
    "tags": [
      "unit",
      "event_bus"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "num_ticks": 2,
  "tick_snapshots": [
    {
      "tick": 1,
      "given": "Event bus in initial state before tick processing",
      "when": "First tick comparison occurs (before lifetime decrement)",
      "then": "Event lifetimes remain at initial values (3 and 5)",
      "data_collection": {
        "entity_collection": {
          "entity_memory_pool_size": 1,
          "entities": []
        },
        "event_bus": {
          "events": [
            {
              "event_lifetime": 3,
              "event_type": "EVENT_TEST",
              "event_data_data_type": "NONE"
            },
            {
              "event_lifetime": 5,
              "event_type": "EVENT_QUIT_GAME",
              "event_data_data_type": "NONE"
            }
          ]
        }
      }
    },
    {
      "tick": 2,
      "given": "Event bus after first tick lifetime decrement",
      "when": "Second tick comparison occurs",
      "then": "Event lifetimes are decremented by 1 (now 2 and 4)",
      "data_collection": {
        "entity_collection": {
          "entity_memory_pool_size": 1,
          "entities": []
        },
        "event_bus": {
          "events": [
            {
              "event_lifetime": 2,
              "event_type": "EVENT_TEST",
              "event_data_data_type": "NONE"
            },
            {
              "event_lifetime": 4,
              "event_type": "EVENT_QUIT_GAME",
              "event_data_data_type": "NONE"
            }
          ]
        }
      }
    }
  ],
  "start_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 1,
      "entities": []
    },
    "event_bus": {
      "events": [
        {
          "event_lifetime": 3,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        },
        {
          "event_lifetime": 5,
          "event_type": "EVENT_QUIT_GAME",
          "event_data_data_type": "NONE"
        }
      ]
    }
  },
  "expected_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 1,
      "entities": []
    },
    "event_bus": {
      "events": [
        {
          "event_lifetime": 1,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        },
        {
          "event_lifetime": 3,
          "event_type": "EVENT_QUIT_GAME",
          "event_data_data_type": "NONE"
        }
      ]
    }
  }
}