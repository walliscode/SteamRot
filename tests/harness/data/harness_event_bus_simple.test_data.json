{
  "metadata": {
    "test_name": "simple_event_bus_test",
    "given": "An event bus with one EVENT_TEST event with lifetime 2",
    "when": "One tick passes",
    "then": "Event lifetime is decremented to 1",
    "tags": [
      "unit",
      "event_bus",
      "simple"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "num_ticks": 1,
  "start_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 1,
      "entities": []
    },
    "event_bus": {
      "events": [
        {
          "event_lifetime": 2,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        }
      ]
    }
  },
  "expected_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 1,
      "entities": []
    },
    "event_bus": {
      "events": [
        {
          "event_lifetime": 1,
          "event_type": "EVENT_TEST",
          "event_data_data_type": "NONE"
        }
      ]
    }
  }
}