/////////////////////////////////////////////////
/// @file
/// @brief Unit tests for PathProvider, TestPaths, and GamePaths classes
/////////////////////////////////////////////////

/////////////////////////////////////////////////
/// Headers
/////////////////////////////////////////////////
#include "GamePaths.h"
#include "PathProvider.h"
#include "TestPaths.h"
#include <catch2/catch_test_macros.hpp>

TEST_CASE("TestPaths provides correct test data directory", "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;

  REQUIRE(test_paths.GetDataDirectory() == "@CMAKE_SOURCE_DIR@/tests/data");
}

TEST_CASE("TestPaths provides correct test fragment directory",
          "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;

  REQUIRE(test_paths.GetFragmentDirectory() ==
          "@CMAKE_SOURCE_DIR@/tests/data/fragments");
}

TEST_CASE("TestPaths provides correct test scene directory",
          "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;

  REQUIRE(test_paths.GetSceneDirectory() ==
          "@CMAKE_SOURCE_DIR@/tests/data/scenes");
}

TEST_CASE("TestPaths provides correct test ui_styles directory",
          "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;

  REQUIRE(test_paths.GetUIStylesDirectory() ==
          "@CMAKE_SOURCE_DIR@/tests/data/ui_styles");
}

TEST_CASE("TestPaths provides correct test assets directory",
          "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;

  REQUIRE(test_paths.GetAssetsDirectory() ==
          "@CMAKE_SOURCE_DIR@/tests/data/assets");
}

TEST_CASE("TestPaths provides correct test fonts directory",
          "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;

  REQUIRE(test_paths.GetFontsDirectory() ==
          "@CMAKE_SOURCE_DIR@/tests/data/assets/fonts");
}

TEST_CASE("GamePaths provides correct production data directory",
          "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;

  REQUIRE(game_paths.GetDataDirectory() == "@CMAKE_SOURCE_DIR@/data");
}

TEST_CASE("GamePaths provides correct production fragment directory",
          "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;

  REQUIRE(game_paths.GetFragmentDirectory() ==
          "@CMAKE_SOURCE_DIR@/data/fragments");
}

TEST_CASE("GamePaths provides correct production scene directory",
          "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;

  REQUIRE(game_paths.GetSceneDirectory() == "@CMAKE_SOURCE_DIR@/data/scenes");
}

TEST_CASE("GamePaths provides correct production ui_styles directory",
          "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;

  REQUIRE(game_paths.GetUIStylesDirectory() ==
          "@CMAKE_SOURCE_DIR@/data/ui_styles");
}

TEST_CASE("GamePaths provides correct production assets directory",
          "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;

  REQUIRE(game_paths.GetAssetsDirectory() == "@CMAKE_SOURCE_DIR@/data/assets");
}

TEST_CASE("GamePaths provides correct production fonts directory",
          "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;

  REQUIRE(game_paths.GetFontsDirectory() ==
          "@CMAKE_SOURCE_DIR@/data/assets/fonts");
}

TEST_CASE("TestPaths can be used as PathProvider reference", "[unit][TestPaths]") {
  steamrot::TestPaths test_paths;
  const steamrot::PathProvider &path_provider = test_paths;

  REQUIRE(path_provider.GetDataDirectory() == "@CMAKE_SOURCE_DIR@/tests/data");
}

TEST_CASE("GamePaths can be used as PathProvider reference", "[unit][GamePaths]") {
  steamrot::GamePaths game_paths;
  const steamrot::PathProvider &path_provider = game_paths;

  REQUIRE(path_provider.GetDataDirectory() == "@CMAKE_SOURCE_DIR@/data");
}
