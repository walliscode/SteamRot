TEST_CASE("FlatbuffersDataLoader::ProvideAssetData with scene type returns "
          "asset data",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;

  // Test for Title scene
  auto title_result =
      data_loader.ProvideAssetData(steamrot::SceneType_TITLE);
  if (!title_result.has_value()) {
    FAIL(title_result.error().message);
  }
  REQUIRE(title_result.value() != nullptr);

  // Test for Crafting scene
  auto crafting_result =
      data_loader.ProvideAssetData(steamrot::SceneType_CRAFTING);
  if (!crafting_result.has_value()) {
    FAIL(crafting_result.error().message);
  }
  REQUIRE(crafting_result.value() != nullptr);
}

TEST_CASE("FlatbuffersDataLoader::ProvideAssetData with invalid scene returns "
          "error",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;
  steamrot::SceneType invalid_scene_type =
      static_cast<steamrot::SceneType>(999);

  auto result = data_loader.ProvideAssetData(invalid_scene_type);

  REQUIRE(!result.has_value());
  REQUIRE(result.error().mode == steamrot::FailMode::SceneTypeNotFound);
}
