#include "FailInfo.h"
#include "FlatbuffersDataLoader.h"
#include "event_packet_generated.h"
#include "scene_types_generated.h"
#include <catch2/catch_test_macros.hpp>

TEST_CASE("FlatbuffersDataLoader provides error if scene type is invalid",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;

  // Use an invalid scene type
  steamrot::SceneType invalid_scene_type =
      static_cast<steamrot::SceneType>(999);

  auto result = data_loader.ProvideDefaultSceneData(invalid_scene_type);

  REQUIRE(!result.has_value());
  REQUIRE(result.error().mode == steamrot::FailMode::SceneTypeNotFound);
  REQUIRE(result.error().message == "Invalid SceneType provided");
}
TEST_CASE("FlatbuffersDataLoader provides scene data",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;

  // Test all Title scene data
  auto title_scene_result =
      data_loader.ProvideDefaultSceneData(steamrot::SceneType::TITLE);

  if (!title_scene_result.has_value()) {
    FAIL(title_scene_result.error().message);
  }
  const auto &scene_data = title_scene_result.value();
  REQUIRE(scene_data != nullptr);
  REQUIRE(scene_data->scene_info()->scene_type() ==
          steamrot::SceneTypeFbs_TITLE);
  REQUIRE(!scene_data->entity_collection()->entities()->empty());
  //.... Additional checks can be added here

  // Test all Crafting scene data
  auto crafting_scene_result =
      data_loader.ProvideDefaultSceneData(steamrot::SceneType::CRAFTING);
  if (!crafting_scene_result.has_value()) {
    FAIL(crafting_scene_result.error().message);
  }
  const auto &crafting_scene_data = crafting_scene_result.value();
  REQUIRE(crafting_scene_data != nullptr);
  REQUIRE(crafting_scene_data->scene_info()->scene_type() ==
          steamrot::SceneTypeFbs_CRAFTING);
  REQUIRE(!crafting_scene_data->entity_collection()->entities()->empty());
  //.... Additional checks can be added here
}

TEST_CASE("FlatbuffersDataLoader provides LogicConfigCollection data",
          "[unit][FlatbuffersDataLoader]") {
  steamrot::FlatbuffersDataLoader data_loader;
  auto result = data_loader.ProvideLogicConfigCollectionFbs();
  if (!result.has_value()) {
    FAIL(result.error().message);
  }
  const auto &logic_config_collection_data = result.value();
  REQUIRE(logic_config_collection_data != nullptr);
  REQUIRE(logic_config_collection_data->test_logic() != nullptr);
  REQUIRE(logic_config_collection_data->test_logic()->subscriptions()->size() ==
          1);
}

TEST_CASE("FlatbuffersDataLoader provides ui_styles data",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;
  auto result = data_loader.ProvideUIStylesData();
  if (!result.has_value()) {
    FAIL(result.error().message);
  }

  std::vector<const steamrot::UIStyleDataFbs *> ui_styles = result.value();
  // check number of styles loaded
  REQUIRE(ui_styles.size() == 1);

  // expected style names. Add more as more styles are added
  std::vector<std::string> expected_style_names = {"default"};

  // check each style name is in the vector
  for (const auto &style : ui_styles) {
    REQUIRE(style != nullptr);
    REQUIRE(std::find(expected_style_names.begin(), expected_style_names.end(),
                      style->name()->str()) != expected_style_names.end());
  }
}

TEST_CASE("FlatbuffersDataLoader provides scene_manager data",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;
  auto result = data_loader.ProvideSceneManagerData();
  REQUIRE(result.has_value());
  REQUIRE(result.value() != nullptr);
}

TEST_CASE("FlatbuffersDataLoader::ProvideEngineData returns data "
          "with correct values",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;
  auto result = data_loader.ProvideEngineDataFbs();

  if (!result.has_value()) {
    FAIL(result.error().message);
  }

  const steamrot::EngineDataFbs *engine_data = result.value();
  const auto *config = engine_data->engine_config();
  REQUIRE(config != nullptr);

  // Test display config
  REQUIRE(config->display() != nullptr);
  REQUIRE(config->display()->window_title() != nullptr);
  REQUIRE(config->display()->window_title()->str() == "SteamRot");
  REQUIRE(config->display()->framerate_limit() == 60);
  REQUIRE(config->display()->fullscreen() == false);
  REQUIRE(config->display()->vsync() == true);

  // Test user preferences config
  REQUIRE(config->user_preferences() != nullptr);
  REQUIRE(config->user_preferences()->master_volume() == 1.0f);
  REQUIRE(config->user_preferences()->show_fps() == false);
  REQUIRE(config->user_preferences()->preferred_language() != nullptr);
  REQUIRE(config->user_preferences()->preferred_language()->str() == "en");

  const auto *resources_config = engine_data->engine_resources_config();
  REQUIRE(resources_config != nullptr);
  // Test resource config values

  REQUIRE(resources_config->window_width() == 800);
  REQUIRE(resources_config->window_height() == 600);
  REQUIRE(resources_config->window_title() != nullptr);
  REQUIRE(resources_config->window_title()->str() == "SteamRot");
  REQUIRE(resources_config->framerate_limit() == 60);

  const auto *state = engine_data->engine_state();

  REQUIRE(state != nullptr);

  // Test engine state values
  REQUIRE(state->running() == false);
  REQUIRE(state->paused() == false);
  REQUIRE(state->quit_requested() == false);

  // Test subscriptions exist
  REQUIRE(state->subscriptions() != nullptr);
  REQUIRE(state->subscriptions()->size() == 1);

  // Verify the subscription is for EVENT_QUIT_GAME
  const auto *subscription = state->subscriptions()->Get(0);
  REQUIRE(subscription != nullptr);
  REQUIRE(subscription->event_type() == steamrot::EventTypeFbs_SYSTEM);
}

TEST_CASE("FlatbuffersDataLoader::ProvideDefaultUserPreferencesData returns "
          "preferences with correct values",
          "[unit][FlatbuffersDataLoader]") {

  steamrot::FlatbuffersDataLoader data_loader;
  auto result = data_loader.ProvideDefaultUserPreferencesData();

  if (!result.has_value()) {
    FAIL(result.error().message);
  }

  const auto *preferences = result.value();
  REQUIRE(preferences != nullptr);

  // Test display preferences
  REQUIRE(preferences->display() != nullptr);
  REQUIRE(preferences->display()->fullscreen() == false);
  REQUIRE(preferences->display()->vsync() == true);

  // Test audio preferences
  REQUIRE(preferences->audio() != nullptr);
  REQUIRE(preferences->audio()->master_volume() == 1.0f);
  REQUIRE(preferences->audio()->music_volume() == 0.8f);
  REQUIRE(preferences->audio()->sfx_volume() == 1.0f);
  REQUIRE(preferences->audio()->muted() == false);

  // Test accessibility preferences
  REQUIRE(preferences->accessibility() != nullptr);
  REQUIRE(preferences->accessibility()->ui_scale() == 1.0f);

  // Test version
  REQUIRE(preferences->version() == 1);
}

