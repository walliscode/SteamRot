{
  "metadata": {
    "test_name": "UI_State_Toggle_From_Button_Click_Logic_Classes",
    "description": "Test button click triggering CUIState toggle using Logic classes. Setup: 4 CUserInterface entities controlled by 1 CUIState. One CUserInterface (toggle_trigger_ui) has a button with response_event_data for EVENT_TOGGLE_UI with trigger action being left click. This CUserInterface is mouse_over active from start. Tick 1: Left click event injected, UIActionLogic processes the button action and adds EVENT_TOGGLE_UI to waiting room. Tick 2: UIStateLogic processes the toggle event, CUIState toggles visibility of controlled UIs, left click event expires from EventBus.",
    "tags": [
      "unit",
      "logic",
      "ui",
      "button",
      "CUIState",
      "multi-tick",
      "event-driven",
      "logic-class"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "simulation_data": {
    "description": "Process UI actions using UIActionLogic to emit toggle event, then update UI visibility from CUIState using UIStateLogic",
    "steps": [
      {
        "simulation_type": "Action",
        "execution_mode": "LogicClass",
        "logic_class_type": "UIActionLogic",
        "description": "Process button actions - button with is_mouse_over=true and active subscriber will emit EVENT_TOGGLE_UI response to waiting room"
      },
      {
        "simulation_type": "Action",
        "execution_mode": "LogicClass",
        "logic_class_type": "UIStateLogic",
        "description": "Update UI visibility based on CUIState mappings when EVENT_TOGGLE_UI is processed"
      }
    ]
  },
