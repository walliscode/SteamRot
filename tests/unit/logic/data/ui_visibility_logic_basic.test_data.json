  "metadata": {
    "test_name": "UIStateLogic_visibility_update_basic_test",
    "description": "Test UIStateLogic class to update UI visibility based on CUIState mappings - 4 UI entities controlled by 1 CUIState entity that manages visibility of 2 of them. Uses LogicClass execution mode with UIStateLogic instead of the free function. Starting state: main_menu visible, play_button invisible, settings_panel invisible, quit_button visible. After logic execution: main_menu visible, play_button visible, settings_panel invisible, quit_button invisible.",
    "tags": ["unit", "logic", "ui", "UIStateLogic"],
    "expected_to_pass": true,
    "version": 1
  },
