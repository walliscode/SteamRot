{
  "metadata": {
    "test_name": "ui_state_no_toggle_multi_tick",
    "description": "Test that UI state updates do NOT toggle visibility back and forth over multiple ticks. When a state key is set, the corresponding UI visibility should be SET (not toggled) and remain stable across ticks. This tests the desired behavior where each state is responsible for one specific UI visibility configuration, not toggling between states.",
    "tags": ["unit", "logic", "ui", "state", "multi-tick", "no-toggle"],
    "expected_to_pass": true,
    "version": 1
  },
  "num_ticks": 3,
  "simulation_data": {
    "description": "Run UpdateCUserInterfaceVisibilityFromCUIState on every tick to verify visibility does NOT toggle back and forth when state subscribers are active on multiple ticks",
    "steps": [
      {
        "simulation_type": "Action",
        "execution_mode": "Function",
        "function_type": "UpdateCUserInterfaceVisibilityFromCUIState",
        "description": "Update UI visibility based on CUIState - visibility should be SET consistently, not toggled"
      }
    ]
  },
  "start_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 5,
      "entities": [
        {
          "index": 0,
          "c_user_interface": {
            "ui_name": "panel_a",
            "is_visible": false,
            "root_ui_element": {
              "base_data": {
                "position": {
                  "x": 100,
                  "y": 100
                },
                "size": {
                  "x": 200,
                  "y": 150
                },
                "children_active": false,
                "children": [],
                "layout": "Vertical",
                "spacing_strategy": "None"
              }
            }
          }
        },
        {
          "index": 1,
          "c_user_interface": {
            "ui_name": "panel_b",
            "is_visible": true,
            "root_ui_element": {
              "base_data": {
                "position": {
                  "x": 350,
                  "y": 100
                },
                "size": {
                  "x": 200,
                  "y": 150
                },
                "children_active": false,
                "children": [],
                "layout": "Vertical",
                "spacing_strategy": "None"
              }
            }
          }
        },
        {
          "index": 2,
          "c_ui_state": {
            "ui_states": [
              {
                "state_key": "show_panel_a",
                "state_to_ui_visibility": {
                  "ui_names_on": ["panel_a"],
                  "ui_names_off": ["panel_b"]
                },
                "subscribers": [
                  {
                    "event_type_data": "EVENT_TOGGLE_UI",
                    "trigger_data_type": "UserInterfaceNameData",
                    "trigger_data": {
                      "id": "show_panel_a"
                    },
                    "active": true
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "event_bus": {
      "description": "EVENT_TOGGLE_UI event with long lifetime to trigger subscriber on multiple ticks",
      "events": [
        {
          "event_lifetime": 4,
          "event_type": "EVENT_TOGGLE_UI",
          "event_data_data_type": "UserInterfaceNameData",
          "event_data_data": {
            "id": "show_panel_a"
          }
        }
      ]
    }
  },
