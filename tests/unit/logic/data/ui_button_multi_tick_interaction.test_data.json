{
  "metadata": {
    "test_name": "ui_button_multi_tick_interaction",
    "description": "Multi-tick UI button interaction test that chains mouse over collision detection with action processing. Tests full subscriber activation workflow across 5 ticks: (1) Mouse moves over button at (150,125), collision detection sets is_mouse_over=true; (2) USER_INPUT event activates subscriber; (3) Mouse click generates input event; (4) ProcessNestedUIActionsAndEvents adds response event to waiting room; (5) Final validation of EventBus and waiting room states. Validates CUserInterface component state transitions and event flow through EventBus and waiting room at each tick.",
    "tags": [
      "unit",
      "logic",
      "ui",
      "button",
      "multi-tick",
      "collision",
      "action",
      "subscriber",
      "event-driven"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "num_ticks": 5,
  "input_sequence": {
    "description": "Simulated mouse inputs: move over button at tick 1, click at tick 3",
    "inputs": [
      {
        "input_type": "MouseMove",
        "input_data_type": "MouseInputData",
        "input_data": {
          "position": {
            "x": 150.0,
            "y": 125.0
          },
          "button": 0
        },
        "tick": 1,
        "description": "Move mouse over button center (button at 100,100 with size 100x50)"
      },
      {
        "input_type": "MouseClick",
        "input_data_type": "MouseInputData",
        "input_data": {
          "position": {
            "x": 150.0,
            "y": 125.0
          },
          "button": 0
        },
        "tick": 3,
        "description": "Click button with left mouse button"
      }
    ]
  },
  "event_sequence": {
    "description": "Events to activate subscriber at tick 2",
    "events": [
      {
        "tick": 2,
        "event_packet": {
          "event_lifetime": 3,
          "event_type": "EVENT_USER_INPUT",
          "event_data_data_type": "UserInputBitsetData",
          "event_data_data": {
            "mouse_released": [
              "LEFT_CLICK"
            ]
          }
        },
        "description": "USER_INPUT event to activate button subscriber"
      }
    ]
  },
  "simulation_data": {
    "description": "Simulation steps: collision detection and action processing on every tick",
    "steps": [
      {
        "simulation_type": "Collision",
        "execution_mode": "Function",
        "function_type": "CheckMouseOverNestedUIElement",
        "description": "Check mouse collision with UI elements (runs every tick)"
      },
      {
        "simulation_type": "Action",
        "execution_mode": "Function",
        "function_type": "ProcessNestedUIActionsAndEvents",
        "description": "Process UI actions and generate response events (runs every tick)"
      }
    ]
  },
  "start_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 5,
      "entities": [
        {
          "index": 0,
          "c_user_interface": {
            "ui_name": "test_button_ui",
