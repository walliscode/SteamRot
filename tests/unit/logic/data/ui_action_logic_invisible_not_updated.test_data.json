{
  "metadata": {
    "test_name": "ui_action_logic_invisible_not_updated",
    "description": "Verify that UIActionLogic does not update a CUserInterface component when is_visible is false. The button should not trigger an event even when is_mouse_over is true and subscription is active.",
    "tags": [
      "unit",
      "logic",
      "UIActionLogic",
      "visibility"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "num_ticks": 1,
  "simulation_data": {
    "description": "Execute UIActionLogic to process button actions - should not process invisible component",
