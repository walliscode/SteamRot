{
  "metadata": {
    "test_name": "ui_collision_logic_invisible_not_updated",
    "description": "Verify that UICollisionLogic does not update a CUserInterface component when is_visible is false. The is_mouse_over should remain false even when mouse position is over the element bounds.",
    "tags": [
      "unit",
      "logic",
      "UICollisionLogic",
      "visibility"
    ],
    "expected_to_pass": true,
    "version": 1
  },
  "input_sequence": {
    "description": "User moves mouse over UI element bounds",
    "inputs": [
      {
        "input_type": "MouseMove",
        "input_data_type": "MouseInputData",
        "input_data": {
          "position": {
            "x": 150.0,
            "y": 125.0
          },
          "button": 0
        },
        "tick": 1,
        "description": "Move mouse over UI element position (150, 125) which is within bounds (100,100) to (300,200)"
      }
    ]
  },
  "simulation_data": {
    "description": "Execute UICollisionLogic to check mouse collision - should not update invisible component",
    "steps": [
      {
        "simulation_type": "Collision",
        "execution_mode": "LogicClass",
        "logic_class_type": "UICollisionLogic",
        "description": "Detect mouse collision with all UI elements - invisible elements should not be updated"
      }
    ]
  },
  "start_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 3,
      "entities": [
        {
          "index": 0,
          "c_user_interface": {
            "ui_name": "invisible_test_panel",
            "is_visible": false,
            "root_ui_element": {
              "base_data": {
                "position": {
                  "x": 100,
                  "y": 100
                },
                "size": {
                  "x": 200,
                  "y": 100
                },
                "children_active": false,
                "children": [],
                "is_mouse_over": false,
                "layout": "Horizontal",
                "spacing_strategy": "None"
              }
            }
          }
        }
      ]
    }
  },
  "expected_data_collection": {
    "entity_collection": {
      "entity_memory_pool_size": 3,
      "entities": [
        {
          "index": 0,
          "c_user_interface": {
            "ui_name": "invisible_test_panel",
            "is_visible": false,
            "root_ui_element": {
              "base_data": {
                "position": {
                  "x": 100,
                  "y": 100
                },
                "size": {
                  "x": 200,
                  "y": 100
                },
                "children_active": false,
                "children": [],
                "is_mouse_over": false,
                "layout": "Horizontal",
                "spacing_strategy": "None"
              }
            }
          }
        }
      ]
    }
  }
}
