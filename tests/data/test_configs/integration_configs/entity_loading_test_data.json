{
  "test_suite": "EntityLoading",
  "description": "Integration test data for entity loading from FlatBuffers through EntityManager",
  "test_cases": [
    {
      "name": "load_single_entity_with_ui",
      "description": "Load a single entity with CUserInterface component",
      "tags": ["integration", "happy_path", "entity_loading"],
      "input": {
        "entity_data": {
          "index": 0,
          "c_user_interface": {
            "ui_name": "TestUI",
            "start_visible": true,
            "root_ui_element": {
              "base_data": {
                "position": {"x": 0.0, "y": 0.0},
                "size": {"x": 100.0, "y": 100.0},
                "children_active": false,
                "children": [],
                "layout": "None",
                "spacing_strategy": "None"
              }
            }
          }
        }
      },
      "expected": {
        "entity_count": 1,
        "entity_0_has_ui": true,
        "entity_0_ui_name": "TestUI",
        "entity_0_ui_visible": true,
        "archetype_count": 1
      }
    },
    {
      "name": "load_multiple_entities",
      "description": "Load multiple entities with different component configurations",
      "tags": ["integration", "multiple_entities"],
      "input": {
        "entities": [
          {
            "index": 0,
            "c_user_interface": {
              "ui_name": "UI_Entity_0",
              "start_visible": true,
              "root_ui_element": {
                "base_data": {
                  "position": {"x": 0.0, "y": 0.0},
                  "size": {"x": 50.0, "y": 50.0},
                  "children_active": false,
                  "children": [],
                  "layout": "None",
                  "spacing_strategy": "None"
                }
              }
            }
          },
          {
            "index": 1,
            "c_user_interface": {
              "ui_name": "UI_Entity_1",
              "start_visible": false,
              "root_ui_element": {
                "base_data": {
                  "position": {"x": 100.0, "y": 100.0},
                  "size": {"x": 75.0, "y": 75.0},
                  "children_active": false,
                  "children": [],
                  "layout": "None",
                  "spacing_strategy": "None"
                }
              }
            }
          }
        ]
      },
      "expected": {
        "entity_count": 2,
        "entity_0_ui_name": "UI_Entity_0",
        "entity_1_ui_name": "UI_Entity_1",
        "entity_0_ui_visible": true,
        "entity_1_ui_visible": false,
        "archetype_count": 1
      }
    },
    {
      "name": "load_entity_with_multiple_components",
      "description": "Load entity with both CUserInterface and CGrimoireMachina",
      "tags": ["integration", "multiple_components"],
      "input": {
        "entity_data": {
          "index": 0,
          "c_user_interface": {
            "ui_name": "CombinedUI",
            "start_visible": true,
            "root_ui_element": {
              "base_data": {
                "position": {"x": 0.0, "y": 0.0},
                "size": {"x": 200.0, "y": 200.0},
                "children_active": false,
                "children": [],
                "layout": "None",
                "spacing_strategy": "None"
              }
            }
          },
          "c_grimoire_machina": {
            "fragments": ["frag1", "frag2"],
            "joints": ["joint1"]
          }
        }
      },
      "expected": {
        "entity_count": 1,
        "entity_0_has_ui": true,
        "entity_0_has_grimoire": true,
        "entity_0_ui_name": "CombinedUI",
        "entity_0_fragment_count": 2,
        "entity_0_joint_count": 1,
        "archetype_count": 1
      }
    },
    {
      "name": "empty_entity_pool",
      "description": "Test with no entities to load",
      "tags": ["integration", "edge_case", "empty_data"],
      "input": {
        "entities": []
      },
      "expected": {
        "entity_count": 0,
        "archetype_count": 0
      }
    }
  ]
}
