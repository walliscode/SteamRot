{
  "test_suite": "CUserInterface",
  "description": "Test data for CUserInterface component configuration from FlatBuffers data",
  "test_cases": [
    {
      "name": "simple_panel_ui",
      "description": "Test CUserInterface with a simple panel element",
      "tags": ["happy_path", "valid_input"],
      "input": {
        "c_user_interface": {
          "ui_name": "TestPanel",
          "start_visible": true,
          "root_ui_element": {
            "base_data": {
              "position": {"x": 0.0, "y": 0.0},
              "size": {"x": 100.0, "y": 100.0},
              "children_active": false,
              "children": [],
              "layout": "None",
              "spacing_strategy": "None"
            }
          }
        }
      },
      "expected": {
        "m_active": true,
        "m_name": "TestPanel",
        "m_UI_visible": true,
        "has_root_element": true,
        "root_element_type": "PanelElement"
      }
    },
    {
      "name": "button_ui",
      "description": "Test CUserInterface with a button element",
      "tags": ["happy_path", "valid_input"],
      "input": {
        "c_user_interface": {
          "ui_name": "TestButton",
          "start_visible": false,
          "root_ui_element": {
            "base_data": {
              "position": {"x": 10.0, "y": 20.0},
              "size": {"x": 80.0, "y": 30.0},
              "children_active": false,
              "children": [],
              "layout": "None",
              "spacing_strategy": "None"
            }
          }
        }
      },
      "expected": {
        "m_active": true,
        "m_name": "TestButton",
        "m_UI_visible": false,
        "has_root_element": true,
        "root_element_type": "PanelElement"
      }
    },
    {
      "name": "default_ui_name",
      "description": "Test CUserInterface with default name",
      "tags": ["edge_case", "default_values"],
      "input": {
        "c_user_interface": {
          "start_visible": true,
          "root_ui_element": {
            "base_data": {
              "position": {"x": 0.0, "y": 0.0},
              "size": {"x": 50.0, "y": 50.0},
              "children_active": false,
              "children": [],
              "layout": "None",
              "spacing_strategy": "None"
            }
          }
        }
      },
      "expected": {
        "m_active": true,
        "m_name": "Default UI",
        "m_UI_visible": true,
        "has_root_element": true
      }
    },
    {
      "name": "nested_ui_elements",
      "description": "Test CUserInterface with nested UI elements",
      "tags": ["complex_case", "nested_data"],
      "input": {
        "c_user_interface": {
          "ui_name": "NestedUI",
          "start_visible": true,
          "root_ui_element": {
            "base_data": {
              "position": {"x": 0.0, "y": 0.0},
              "size": {"x": 200.0, "y": 200.0},
              "children_active": true,
              "children": [
                {
                  "element": {
                    "base_data": {
                      "position": {"x": 10.0, "y": 10.0},
                      "size": {"x": 50.0, "y": 50.0},
                      "children_active": false,
                      "children": [],
                      "layout": "None",
                      "spacing_strategy": "None"
                    }
                  }
                }
              ],
              "layout": "Vertical",
              "spacing_strategy": "Even"
            }
          }
        }
      },
      "expected": {
        "m_active": true,
        "m_name": "NestedUI",
        "m_UI_visible": true,
        "has_root_element": true,
        "has_child_elements": true,
        "child_count": 1
      }
    },
    {
      "name": "empty_ui_name",
      "description": "Test CUserInterface with empty string name",
      "tags": ["edge_case", "empty_string"],
      "input": {
        "c_user_interface": {
          "ui_name": "",
          "start_visible": false,
          "root_ui_element": {
            "base_data": {
              "position": {"x": 0.0, "y": 0.0},
              "size": {"x": 100.0, "y": 100.0},
              "children_active": false,
              "children": [],
              "layout": "None",
              "spacing_strategy": "None"
            }
          }
        }
      },
      "expected": {
        "m_active": true,
        "m_name": "",
        "m_UI_visible": false,
        "has_root_element": true
      }
    }
  ]
}
