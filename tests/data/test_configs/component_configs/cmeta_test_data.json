{
  "test_suite": "CMeta",
  "description": "Test data for CMeta component configuration",
  "test_cases": [
    {
      "name": "entity_active_true",
      "description": "Test CMeta with entity active set to true",
      "tags": ["happy_path", "valid_input"],
      "input": {
        "c_meta": {
          "entity_active": true
        }
      },
      "expected": {
        "m_active": true,
        "m_entity_active": true
      }
    },
    {
      "name": "entity_active_false",
      "description": "Test CMeta with entity active set to false",
      "tags": ["valid_input"],
      "input": {
        "c_meta": {
          "entity_active": false
        }
      },
      "expected": {
        "m_active": true,
        "m_entity_active": false
      }
    },
    {
      "name": "default_values",
      "description": "Test CMeta with default initialization",
      "tags": ["edge_case", "default_values"],
      "input": {
        "c_meta": {}
      },
      "expected": {
        "m_active": false,
        "m_entity_active": false
      }
    }
  ]
}
