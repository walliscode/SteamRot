{
  "test_suite": "CGrimoireMachina",
  "description": "Test data for CGrimoireMachina component configuration from FlatBuffers data",
  "test_cases": [
    {
      "name": "default_configuration",
      "description": "Test CGrimoireMachina with valid fragment and joint data",
      "tags": ["happy_path", "valid_input"],
      "input": {
        "c_grimoire_machina": {
          "fragments": ["fragment1", "fragment2", "fragment3"],
          "joints": ["joint1", "joint2"]
        }
      },
      "expected": {
        "m_active": true,
        "m_all_fragments_count": 3,
        "m_all_joints_count": 2,
        "fragment_names": ["fragment1", "fragment2", "fragment3"],
        "joint_names": ["joint1", "joint2"]
      }
    },
    {
      "name": "empty_fragments_and_joints",
      "description": "Test CGrimoireMachina with empty fragment and joint arrays",
      "tags": ["edge_case", "empty_data"],
      "input": {
        "c_grimoire_machina": {
          "fragments": [],
          "joints": []
        }
      },
      "expected": {
        "m_active": true,
        "m_all_fragments_count": 0,
        "m_all_joints_count": 0
      }
    },
    {
      "name": "single_fragment_single_joint",
      "description": "Test CGrimoireMachina with minimal valid data",
      "tags": ["edge_case", "minimal_data"],
      "input": {
        "c_grimoire_machina": {
          "fragments": ["single_fragment"],
          "joints": ["single_joint"]
        }
      },
      "expected": {
        "m_active": true,
        "m_all_fragments_count": 1,
        "m_all_joints_count": 1,
        "fragment_names": ["single_fragment"],
        "joint_names": ["single_joint"]
      }
    },
    {
      "name": "many_fragments_many_joints",
      "description": "Test CGrimoireMachina with large number of fragments and joints",
      "tags": ["stress_test", "large_data"],
      "input": {
        "c_grimoire_machina": {
          "fragments": [
            "frag_01", "frag_02", "frag_03", "frag_04", "frag_05",
            "frag_06", "frag_07", "frag_08", "frag_09", "frag_10"
          ],
          "joints": [
            "joint_01", "joint_02", "joint_03", "joint_04", "joint_05",
            "joint_06", "joint_07", "joint_08", "joint_09", "joint_10"
          ]
        }
      },
      "expected": {
        "m_active": true,
        "m_all_fragments_count": 10,
        "m_all_joints_count": 10
      }
    },
    {
      "name": "duplicate_fragment_names",
      "description": "Test CGrimoireMachina behavior with duplicate fragment names",
      "tags": ["edge_case", "duplicate_data"],
      "input": {
        "c_grimoire_machina": {
          "fragments": ["fragment1", "fragment1", "fragment2"],
          "joints": ["joint1"]
        }
      },
      "expected": {
        "m_active": true,
        "m_all_fragments_count": 2,
        "m_all_joints_count": 1,
        "fragment_names": ["fragment1", "fragment2"]
      }
    }
  ]
}
