
include "../entities/entities.fbs";
include "../core/scene_types.fbs";
include "../events/event_bus_data.fbs";
include "../events/subscriber.fbs";
include "../engine/engine_state.fbs";
include "../scenes/scene_data.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// Metadata for save file management
////////////////////////////////////////////////////////////
table SaveMetadata {
  /// Display name for the save slot
  save_name: string;
  
  /// Timestamp when save was created (ISO 8601 format)
  created_at: string;
  
  /// Timestamp when save was last modified (ISO 8601 format)
  last_modified: string;
  
  /// Game version that created this save
  game_version: string;
  
  /// Total play time in seconds
  play_time_seconds: uint64 = 0;
  
  /// Save slot identifier (0-based index)
  slot_index: uint32 = 0;
}

////////////////////////////////////////////////////////////
/// Scene manager runtime state for saves
////////////////////////////////////////////////////////////
table SceneManagerStateFbs {
  /// Scene manager level subscribers
  subscriptions: [SubscriberFbs];
}

////////////////////////////////////////////////////////////
/// Scene runtime state for saves
////////////////////////////////////////////////////////////
table SceneStateFbs {
  /// Is the scene active
  active: bool = true;
}

////////////////////////////////////////////////////////////
/// Root table containing complete save game data
////////////////////////////////////////////////////////////
table SaveData {
  /// Metadata about this save file (required)
  metadata: SaveMetadata (required);
  
  /// Scene data for the saved scene (required)
  scene_data: SceneDataFbs (required);
  
  /// Engine state at time of save
  engine_state: EngineStateFbs;
  
  /// Scene manager state at time of save
  scene_manager_state: SceneManagerStateFbs;
  
  /// Scene state at time of save
  scene_state: SceneStateFbs;
}

root_type SaveData;
