
include "../entity/entities.fbs";
include "../core/scene_types.fbs";
include "../scenes/scene_collection_data.fbs";
include "../events/event_bus_data.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// Metadata for save file management
////////////////////////////////////////////////////////////
table SaveMetaDataFbs{

  /// Display name for the save slot
  save_name: string;

  /// Unique identifier from the file prefix
  file_id: string;

  
}


////////////////////////////////////////////////////////////
/// Root table containing complete save game data
////////////////////////////////////////////////////////////
table SaveDataFbs{
  /// Metadata for the save file
  save_meta_data: SaveMetaDataFbs;

  /// Collection of scene data in the save file
scene_collection_data: SceneCollectionDataFbs;
}

root_type SaveDataFbs;
