include "../core/types.fbs";

namespace steamrot;



table StyleDataFbs{
  background_color: ColorDataFbs(required); 
  border_color: ColorDataFbs(required);
  border_thickness: float ;
  radius_resolution: int ;
  inner_margin: Vector2fDataFbs (required);
  minimum_size: Vector2fDataFbs (required);
  maximum_size: Vector2fDataFbs (required);
}

table PanelStyleDataFbs{
  style: StyleDataFbs (required);
  }

table ButtonStyleDataFbs {
  style: StyleDataFbs (required);
  text_color: ColorDataFbs (required);
  hover_color: ColorDataFbs (required);
  font: string (required);
  font_size: int;
  }

table DropDownContainerStyleDataFbs {
  style: StyleDataFbs (required);
  drop_symbol_ratio: float;
  }

table DropDownListStyleDataFbs {
  style: StyleDataFbs (required);
  text_color: ColorDataFbs(required);
  hover_color: ColorDataFbs (required);
  font: string (required);
  font_size: int;
  }

table DropDownItemStyleDataFbs {
  style: StyleDataFbs (required);
  text_color: ColorDataFbs (required);
  hover_color: ColorDataFbs (required);
  font: string (required);
  font_size: int;
  }

table DropDownButtonStyleDataFbs {
  style: StyleDataFbs (required);
triangle_color: ColorDataFbs (required);
  hover_color: ColorDataFbs (required);
}

table UIStyleDataFbs{
    panel_style: PanelStyleDataFbs (required);
    button_style: ButtonStyleDataFbs (required);
    drop_down_container_style: DropDownContainerStyleDataFbs (required);
    drop_down_list_style: DropDownListStyleDataFbs (required);
    drop_down_item_style: DropDownItemStyleDataFbs (required);
    drop_down_button_style: DropDownButtonStyleDataFbs (required);
    name: string (required);
  }



root_type UIStyleDataFbs;
