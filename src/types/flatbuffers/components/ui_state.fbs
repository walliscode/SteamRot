include "../events/subscriber.fbs";

namespace steamrot;

// Maps a state key to lists of UI components to show/hide and enable/disable
table UIStateChangesFbs {

  ui_names_on: [string];
  ui_names_off: [string];
  ui_names_disabled: [string];
  ui_names_enabled: [string];

}

table UIStateDataFbs {
  // Collection of state key to UI change mappings
  state_key: string (required);
  ui_state_changes: UIStateChangesFbs;
  subscribers: [SubscriberFbs];
}

table UIStateCollectionDataFbs {
  ui_states: [UIStateDataFbs] (required);
}
