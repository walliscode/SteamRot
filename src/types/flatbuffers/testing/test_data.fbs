include "simulation_data.fbs";
include "input_data.fbs";
include "../engine/engine_state.fbs";
include "../core/engine_snapshot.fbs";
include "../events/event_packet.fbs";
include "../core/scene_types.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// @brief Test metadata for data-driven testing
///
/// This table contains metadata about a test case that can
/// be extended in the future with additional fields.
////////////////////////////////////////////////////////////
table TestMetadataFbs {
  /// @brief Human-readable name for the test case
  test_name: string (required);
  
  /// @brief Optional description of what the test validates
  test_description: string;
  
  /// @brief Tags for categorizing tests (e.g., "unit", "integration")
  tags: [string];
  
  /// @brief Expected test outcome (true = should pass, false = should fail)
  will_pass: bool = true;
   
  /// @brief Version identifier for this schema
  version: uint32;
}


////////////////////////////////////////////////////////////
/// @brief Represents a single tick-to-events mapping
///
/// FlatBuffers doesn't support maps directly, so we represent
/// the C++ std::unordered_map<unint64, std::vector<EventPacketFbs> as a vector of these pairs.
////////////////////////////////////////////////////////////
table TickEventsPairFbs {
  /// @brief Tick number (key in the map)
  tick: uint64(key);
  
  /// @brief All event packets to be inserted at tick
  events: [EventPacketFbs];
}

////////////////////////////////////////////////////////////
/// @brief Represents a single tick-to-snapshot mapping
///
/// FlatBuffers doesn't support maps directly, so we represent
/// the C++ std::map<size_t, EngineSnapshot> as a vector of these pairs.
////////////////////////////////////////////////////////////
table TickSnapshotPairFbs {
  /// @brief Tick number (key in the map)
  tick: uint64 (key);
  
  /// @brief Engine snapshot at this tick
  snapshot: EngineSnapshotFbs;
}

////////////////////////////////////////////////////////////
/// @brief Represents a single tick-to-input-events mapping
///
/// FlatBuffers doesn't support maps directly, so we represent
/// the C++ std::unordered_map<size_t, std::vector<sf::Event>> as a
/// vector of these pairs.
////////////////////////////////////////////////////////////
table TickInputsPairFbs {
  /// @brief Tick number (key in the map)
  tick: uint64 (key);

  /// @brief All input events to be injected at this tick
  inputs: [InputEventFbs];
}

////////////////////////////////////////////////////////////
/// @brief Root table for test data configuration
///
/// This is the main container for test data. It's designed
/// to be extensible - new data types can be added as optional
/// fields without breaking existing tests.
////////////////////////////////////////////////////////////
table TestDataFbs
{
  /// @brief Metadata about this test case
  meta_data: TestMetadataFbs (required);
    
  /// @brief Simulation data for executing logic steps during tests
  simulation_data: SimulationDataFbs;

    
  /// @brief Number of ticks to run the test for
  /// Note: Field name is num_ticks in schema but maps to number_of_ticks in C++
  num_ticks: uint32 = 1;
   
  /// @brief Starting engine snapshot before simulation begins
  starting_engine_snapshot: EngineSnapshotFbs;
  
  /// @brief Expected engine snapshots at specific ticks
  ///
  /// Maps tick numbers to expected engine states for validation.
  /// In C++, this becomes std::map<size_t, EngineSnapshot>.
  expected_engine_snapshots: [TickSnapshotPairFbs];

  /// @brief Input events to inject per tick
  ///
  /// Maps tick numbers to the input events to simulate at that tick.
  /// In C++, this becomes std::unordered_map<size_t, std::vector<sf::Event>>.
  input_events: [TickInputsPairFbs];

  /// @brief If set, the TestEngine loads this scene from default data instead
  /// of using starting_engine_snapshot. UNKNOWN (0) means use
  /// starting_engine_snapshot (default behavior).
  initial_scene_type: SceneTypeFbs = UNKNOWN;
}

root_type TestDataFbs;
