include "event_packet.fbs";
include "event_payload.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// @brief FlatBuffers table for Subscriber data
///
/// Represents subscriber configuration that can be loaded
/// from JSON/binary files.
////////////////////////////////////////////////////////////
table SubscriberFbs {
  /// Active state of the subscriber
  active: bool = false;
  
  /// Event type that this subscriber listens for
  event_type_data: EventTypeFbs;
  
  /// Optional trigger payload - subscriber only activates if event payload matches
  trigger_data: EventPayloadFbs;
  
  /// Optional received event payload (typically not set in config files)
  received_data: EventPayloadFbs;
}
