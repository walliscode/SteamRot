include "user_input.fbs";
include "../core/scene_types.fbs";

namespace steamrot;

enum EventTypeFbs: ulong (bit_flags) {
EVENT_NONE = 0,
EVENT_TEST,
EVENT_USER_INPUT,
EVENT_TOGGLE_UI,
EVENT_CHANGE_SCENE,
EVENT_QUIT_GAME,
EVENT_TOGGLE_DROPDOWN,
EVENT_TOGGLE_NAME
  }

table UserInterfaceNameData {
    id: string;
  }

table ToggleNameFbs {
    name: string;
  }

union EventDataData{
  UserInputBitsetData,
  SceneChangePacketData,
  UserInterfaceNameData,
  ToggleNameFbs
  }



