// general types to use in other schemas
namespace steamrot;

table Vector2fDataFbs {
    x: float;
    y: float;
  }


table ColorDataFbs{
    r:uint8;
    g:uint8;
    b:uint8;
    a:uint8;
  }


table VertexFbs {
  position: Vector2fDataFbs(required);
  color: ColorDataFbs (required);
}


table TriangleFbs {
vertices: [VertexFbs] (required);
  }
