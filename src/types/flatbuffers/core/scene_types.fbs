// Scene-related types that are used across multiple schemas
// This file exists to break circular dependencies between events and scene_data
namespace steamrot;

enum SceneTypeFbs: byte {
  UNKNOWN = 0,
  TEST = 1,
  TITLE = 2,
  CRAFTING = 3
}

table SceneChangePacketDataFbs {
  uuid: string;
  scene_type: SceneTypeFbs;
}
