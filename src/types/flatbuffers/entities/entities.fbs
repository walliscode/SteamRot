include "user_interface.fbs";
include "ui_state.fbs";
namespace steamrot;


table EntityDataFbs{
  index: uint32;
  c_user_interface: UserInterfaceFbs;
  c_ui_state: UIStateCollectionDataFbs;

  }

// wrapper table to allow for metadata in the future
table EntityCollectionFbs {
  entities: [EntityDataFbs] (required);
  entity_memory_pool_size: int;
}

root_type EntityCollectionFbs;

