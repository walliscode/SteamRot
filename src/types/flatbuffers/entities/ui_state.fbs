include "../events/subscriber.fbs";

namespace steamrot;

// Maps a state key to lists of UI components that should be on/off
table UIStateMappingFbs {

  ui_names_on: [string];
  ui_names_off: [string];  

}

table UIStateDataFbs {
  // Collection of state key to UI visibility mappings
  state_key: string (required);
  state_to_ui_visibility: UIStateMappingFbs;
  subscribers: [SubscriberFbs];
}

table UIStateCollectionDataFbs {
  ui_states: [UIStateDataFbs] (required);
}
