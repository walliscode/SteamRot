include "../core/types.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// @brief Types of input events that can be simulated
////////////////////////////////////////////////////////////
enum InputTypeFbs : byte {
  MouseMove,
  MouseClick,
  MouseRelease,
  KeyPress,
  KeyRelease
}

////////////////////////////////////////////////////////////
/// @brief Mouse input data for simulation
////////////////////////////////////////////////////////////
table MouseInputDataFbs {
  position: Vector2fDataFbs;
  button: uint8;  // SFML mouse button enum
}

////////////////////////////////////////////////////////////
/// @brief Keyboard input data for simulation
////////////////////////////////////////////////////////////
table KeyboardInputDataFbs {
  key_code: uint32;  // SFML key code
  alt: bool = false;
  control: bool = false;
  shift: bool = false;
}

////////////////////////////////////////////////////////////
/// @brief Union of possible input data types
////////////////////////////////////////////////////////////
union InputEventDataFbs {
  MouseInputDataFbs,
  KeyboardInputDataFbs
}

////////////////////////////////////////////////////////////
/// @brief A single input event to be simulated
///
/// Each input event represents a discrete input action that can be
/// injected into the test fixture at a specific tick/timestamp.
////////////////////////////////////////////////////////////
table InputEventFbs {
  /// @brief Type of input event
  input_type: InputTypeFbs;

  /// @brief Input-specific data
  input_data: InputEventDataFbs;

  /// @brief Optional description for debugging
  description: string;
}

////////////////////////////////////////////////////////////
/// @brief Sequence of input events for simulation
///
/// Represents a complete sequence of inputs at a given tick
////////////////////////////////////////////////////////////
table InputSequenceFbs {
  /// @brief Ordered list of input events
  inputs: [InputEventFbs];

  /// @brief Tick at which to insert the inputs
  tick: uint32;
}


