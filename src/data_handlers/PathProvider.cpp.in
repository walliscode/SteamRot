/////////////////////////////////////////////////
/// @file
/// @brief Implementation of PathProvider abstract class helper methods
/////////////////////////////////////////////////

/////////////////////////////////////////////////
/// Headers
/////////////////////////////////////////////////
#include "PathProvider.h"

namespace steamrot {

/////////////////////////////////////////////////
std::filesystem::path PathProvider::GetFragmentDirectory() const {
  return GetDataDirectory() / "fragments";
}

/////////////////////////////////////////////////
std::filesystem::path PathProvider::GetSceneDirectory() const {
  return GetDataDirectory() / "scenes";
}

/////////////////////////////////////////////////
std::filesystem::path PathProvider::GetAssetsDirectory() const {
  return GetDataDirectory() / "assets";
}

/////////////////////////////////////////////////
std::filesystem::path PathProvider::GetFontsDirectory() const {
  return GetAssetsDirectory() / "fonts";
}

/////////////////////////////////////////////////
std::filesystem::path PathProvider::GetUIStylesDirectory() const {
  return GetDataDirectory() / "ui_styles";
}
} // namespace steamrot
