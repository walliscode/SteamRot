#include "TestPaths.h"

namespace steamrot {

/////////////////////////////////////////////////
std::filesystem::path TestPaths::GetDataDirectory() const {
  return std::filesystem::path{"@CMAKE_SOURCE_DIR@"} / "tests" / "data";
}

} // namespace steamrot
