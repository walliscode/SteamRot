include "entities.fbs";
include "events.fbs";
include "scenes.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// @brief Union representing different levels of test data
////////////////////////////////////////////////////////////
union TestDataLevel {
  EntityMemoryPoolData: EntityCollection,
  SceneData: SceneCollectionData,
  EventBusData: EventBusStateData,
  ComponentData: ComponentStateData,
}

////////////////////////////////////////////////////////////
/// @brief Represents the state of the event bus at a point in time
////////////////////////////////////////////////////////////
table EventBusStateData {
  events: [EventPacketStateData];
}

////////////////////////////////////////////////////////////
/// @brief Represents a single event packet for testing
////////////////////////////////////////////////////////////
table EventPacketStateData {
  event_type: EventType;
  // Event data would be serialized here if needed
}

////////////////////////////////////////////////////////////
/// @brief Represents component states for testing
////////////////////////////////////////////////////////////
table ComponentStateData {
  entities: EntityCollection;
  // Additional metadata can be added here
}

////////////////////////////////////////////////////////////
/// @brief Scene collection for testing multiple scenes
////////////////////////////////////////////////////////////
table SceneCollectionData {
  scenes: [SceneStateData];
}

////////////////////////////////////////////////////////////
/// @brief Represents a scene state for testing
////////////////////////////////////////////////////////////
table SceneStateData {
  scene_type: SceneType;
  entities: EntityCollection;
}

////////////////////////////////////////////////////////////
/// @brief Metadata for a test case
////////////////////////////////////////////////////////////
table TestMetadata {
  test_name: string (required);
  test_description: string;
  tick: uint32 = 0;
  test_tags: [string];
  expected_result: TestExpectedResult = PASS;
}

////////////////////////////////////////////////////////////
/// @brief Expected result of a test
////////////////////////////////////////////////////////////
enum TestExpectedResult: byte {
  PASS = 0,
  FAIL = 1,
  SKIP = 2,
}

////////////////////////////////////////////////////////////
/// @brief Represents a single test case state
////////////////////////////////////////////////////////////
table TestStateSnapshot {
  metadata: TestMetadata (required);
  data: TestDataLevel (required);
}

////////////////////////////////////////////////////////////
/// @brief Represents before and after states for a test
////////////////////////////////////////////////////////////
table TestCase {
  metadata: TestMetadata (required);
  before_state: TestStateSnapshot;
  after_state: TestStateSnapshot;
  intermediate_states: [TestStateSnapshot];
}

////////////////////////////////////////////////////////////
/// @brief Root table for test data file
////////////////////////////////////////////////////////////
table TestDataFile {
  version: uint32 = 1;
  test_case: TestCase (required);
}

root_type TestDataFile;
