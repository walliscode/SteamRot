include "entities.fbs";
include "resource_data.fbs";
include "simulation.fbs";
include "input_test_data.fbs";
include "event_test_data.fbs";
include "event_bus_data.fbs";

namespace steamrot;

////////////////////////////////////////////////////////////
/// @brief Collection of data structures for comparison testing
///
/// Represents the state of various game data structures (entity pool,
/// event bus, etc.) at a specific point in time. Used for comparing
/// actual vs expected states in tests.
////////////////////////////////////////////////////////////
table DataCollection {
  /// @brief state of entities
  entity_collection: EntityCollection;

  /// @brief state of the global event bus
  event_bus: EventBusData;

  /// @brief state of the waiting room event bus
  waiting_room: EventBusData;
}

////////////////////////////////////////////////////////////
/// @brief Snapshot of expected data structure state at a specific tick
///
/// Represents a checkpoint during test execution where the
/// actual data structure state should match the expected state defined
/// in the data_collection field.
///
/// Note: Tick numbering is 1-based to mimic the game loop.
/// The setup phase occurs before tick 1. Valid tick values start at 1.
////////////////////////////////////////////////////////////
table TickSnapshot {
  /// @brief Tick number when this snapshot should be compared (1-based)
  /// The comparison happens AFTER simulation steps execute for this tick,
  /// but BEFORE the event bus is ticked.
  /// Valid values: 1, 2, 3, ... (matching game loop tick numbers)
  tick: uint32;
  
  /// @brief Expected data structure state at this tick
  /// Contains entity collection and event bus state.
  /// Comparison happens AFTER simulation steps, BEFORE event bus tick.
  data_collection: DataCollection (required);
  
  /// @brief Optional human-readable description of this checkpoint
  /// Used in failure messages to identify which snapshot failed.
  description: string;
}

////////////////////////////////////////////////////////////
/// @brief Test metadata for data-driven testing
///
/// This table contains metadata about a test case that can
/// be extended in the future with additional fields.
////////////////////////////////////////////////////////////
table TestMetadata {
  /// @brief Human-readable name for the test case
  test_name: string (required);
  
  /// @brief Optional description of what the test validates
  description: string;
  
  /// @brief Tags for categorizing tests (e.g., "unit", "integration")
  tags: [string];
  
  /// @brief Expected test outcome (true = should pass, false = should fail)
  expected_to_pass: bool = true;
  
  /// @brief Optional author or creator of the test case
  author: string;
  
  /// @brief Version identifier for the test data format
  version: uint32 = 1;
}

////////////////////////////////////////////////////////////
/// @brief Root table for test data configuration
///
/// This is the main container for test data. It's designed
/// to be extensible - new data types can be added as optional
/// fields without breaking existing tests.
////////////////////////////////////////////////////////////
table TestDataConfig {
  /// @brief Metadata about this test case
  metadata: TestMetadata (required);
    
  /// @brief Starting state data collection for comparison tests
  /// Contains entity collection and event bus state at test start.
  /// If not provided, defaults to default-constructed data structures.
  start_data_collection: DataCollection;
  
  /// @brief Expected state data collection for comparison tests
  /// Contains expected entity collection and event bus state after test execution.
  /// If present, the test harness will compare actual state with expected state.
  expected_data_collection: DataCollection;
  
  /// @brief Resource data for test fixtures
  game_resources: GameResourcesData;
  scene_resources: SceneResourcesData;
  
  /// @brief Simulation data for executing logic steps during tests
  simulation_data: SimulationData;
  
  /// @brief Input sequence for simulating user input tick-by-tick
  input_sequence: InputSequence;
  
  /// @brief Event sequence for adding events tick-by-tick
  event_sequence: EventSequence;
  
  /// @brief Number of ticks to run the test for (default: 1)
  /// This is the ONLY field consulted to determine tick count. The test will execute for exactly
  /// this many ticks, processing inputs, events, and simulation steps scheduled for each tick.
  /// If not specified (value is 0), defaults to 1 tick.
  /// Note: input_sequence, event_sequence, and simulation_data.num_ticks are NOT consulted
  /// for tick determination. Only this TestDataConfig level field is used.
  num_ticks: uint32;
  
  /// @brief Intermediate entity state snapshots for tick-by-tick validation
  /// Optional field. If present, the test harness will compare actual entity
  /// state with expected state at each specified tick.
  /// Snapshots are compared AFTER simulation steps but BEFORE event bus tick.
  tick_snapshots: [TickSnapshot];
  
  /// @brief Reserved for future test data types
  /// Can be extended with additional fields like:
  /// - ui_data: UITestData;
  /// - scene_transitions: SceneTransitionSequence;
  /// etc.
}

root_type TestDataConfig;
