include "entities.fbs";
include "assets.fbs";
include "scene_types.fbs";
include "logic_data.fbs";

namespace steamrot;

table SceneDataData{
    entity_collection: EntityCollection;
    assets: AssetCollection;
    render_texture_width: uint32 = 800;
    render_texture_height: uint32 = 600;
    scene_id: string;
    scene_type: SceneType;
    logic_collection_data: LogicCollectionData;
  }

root_type SceneDataData;
