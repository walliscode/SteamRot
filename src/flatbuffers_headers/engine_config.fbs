////////////////////////////////////////////////////////////
/// @file
/// @brief FlatBuffers schema for engine configuration.
///
/// EngineConfig contains user-configurable engine settings that
/// can be loaded separately from the main engine data. This supports
/// the cascading defaults/user configuration system.
///
/// ## Loading Order
/// 1. Load default EngineConfig from defaults/engine/engine_config.bin
/// 2. If user/engine/engine_config.bin exists, override with user settings
///
/// ## Distinction from EngineData
/// - EngineConfig: User preferences and runtime settings
/// - EngineData: Core engine state, subscriptions, event buses
////////////////////////////////////////////////////////////

namespace steamrot;

////////////////////////////////////////////////////////////
/// Engine configuration settings
/// Contains user-configurable settings like window preferences
////////////////////////////////////////////////////////////
table EngineConfigData {
  /// Window width in pixels
  window_width: uint32 = 800;
  
  /// Window height in pixels
  window_height: uint32 = 600;
  
  /// Window title
  window_title: string;
  
  /// Target framerate limit
  framerate_limit: uint32 = 60;
  
  /// Fullscreen mode enabled
  fullscreen: bool = false;
  
  /// VSync enabled
  vsync: bool = true;
}

root_type EngineConfigData;
