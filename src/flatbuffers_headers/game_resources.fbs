namespace steamrot;

////////////////////////////////////////////////////////////
// Configuration for GameResources
////////////////////////////////////////////////////////////
table GameResourcesData {
  window_width: uint32 = 800;
  window_height: uint32 = 600;
  window_title: string;
  framerate_limit: uint32 = 60;
  environment_type: string; // "None", "Test", "Production"
}

root_type GameResourcesData;
