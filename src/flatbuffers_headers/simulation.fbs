namespace steamrot;

////////////////////////////////////////////////////////////
/// @brief Types of simulation systems matching Scene logic organization
////////////////////////////////////////////////////////////
enum SimulationType : byte {
  Action = 0,
  Movement = 1,
  Render = 2,
  Collision = 3
}

////////////////////////////////////////////////////////////
/// @brief Types of individual functions that can be called during simulation
///
/// This enum allows test data to specify which specific free functions
/// to call during simulation execution.
////////////////////////////////////////////////////////////
enum FunctionType : byte {
  None = 0,
  
  // UI Action functions
  ProcessUIActionsAndEvents = 1,
  ProcessNestedUIActionsAndEvents = 2,
  ProcessButtonElementActions = 3,
  ProcessDropDownListElementActions = 4,
  
  // Future: Add other free functions as needed
  // ProcessUICollision = 10,
  // ProcessUIRender = 20,
  // ProcessMovement = 30,
}

////////////////////////////////////////////////////////////
/// @brief Execution mode for a simulation step
///
/// Determines whether to execute individual functions or entire Logic classes
////////////////////////////////////////////////////////////
enum ExecutionMode : byte {
  /// Execute individual free function specified by function_type
  Function = 0,
  
  /// Execute entire Logic class specified by logic_type
  LogicClass = 1
}

////////////////////////////////////////////////////////////
/// @brief Logic class types that can be executed
///
/// Matches the Logic class hierarchy in the codebase
////////////////////////////////////////////////////////////
enum LogicClassType : byte {
  None = 0,
  UIActionLogic = 1,
  UICollisionLogic = 2,
  UIRenderLogic = 3,
  UIStateLogic = 4,
  CraftingRenderLogic = 5,
  // Future: Add other Logic classes as needed
}

////////////////////////////////////////////////////////////
/// @brief A single step in a simulation sequence
///
/// Each step specifies what to execute (function or Logic class)
/// and which system category it belongs to.
////////////////////////////////////////////////////////////
table SimulationStep {
  /// @brief Which system this step belongs to (Action, Movement, Render, Collision)
  simulation_type: SimulationType;
  
  /// @brief Whether to execute a function or a Logic class
  execution_mode: ExecutionMode;
  
  /// @brief Which specific function to call (if execution_mode is Function)
  function_type: FunctionType = None;
  
  /// @brief Which Logic class to execute (if execution_mode is LogicClass)
  logic_class_type: LogicClassType = None;
  
  /// @brief Optional description of what this step does
  description: string;
}

////////////////////////////////////////////////////////////
/// @brief Complete simulation configuration
///
/// Defines a sequence of steps to execute during testing.
/// Steps are executed in the order they appear in the array.
////////////////////////////////////////////////////////////
table SimulationData {
  /// @brief Ordered sequence of simulation steps to execute
  steps: [SimulationStep];
  
  /// @brief Optional description of the overall simulation
  description: string;
  
  /// @brief DEPRECATED: This field is NOT used for tick determination.
  /// Use TestDataConfig.num_ticks instead to control tick count.
  /// This field is kept for backward compatibility but has no effect.
  num_ticks: uint32 = 1;
}
